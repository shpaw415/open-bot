{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "ESNext",
    "module": "preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": [
      "@cloudflare/workers-types"
    ],
    "paths": {
      "frame-master-plugin-apply-react/router": [
        "./src/types/apply-react-router.d.ts"
      ],
      "frame-master-plugin-cloudflare-pages-dynamic-ssr/utils/nextjs": [
        "./src/types/vendor/nextjs.d.ts"
      ],
      "frame-master-plugin-cloudflare-pages-dynamic-ssr/middleware": [
        "./src/types/vendor/middleware.d.ts"
      ],
      "frame-master-plugin-cloudflare-pages-dynamic-ssr/provider/store/kv": [
        "./src/types/vendor/kv.d.ts"
      ],
      "frame-master-plugin-cloudflare-pages-dynamic-ssr/client/context": [
        "./src/types/vendor/client-context.d.ts"
      ],
      "frame-master-plugin-cloudflare-pages-dynamic-ssr/client/hooks": [
        "./src/types/vendor/client-hooks.d.ts"
      ],
      "@static/*": [
        "./static/*"
      ],
      "@api/*": [
        "./src/actions/api/*"
      ],
      "@components/*": [
        "./src/components/*"
      ]
    }
  },
  "include": [
    "./src",
    "./types.d.ts",
    "./site.config.ts",
    "../workers/review-worker/src/review-consumer.ts"
  ],
  "exclude": [
    ".frame-master",
    "**/*.test.ts"
  ]
}