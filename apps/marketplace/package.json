{
  "name": "@open-bot/marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun frame-master start",
    "build": "NODE_ENV=production bun frame-master build",
    "build:dev": "NODE_ENV=development bun frame-master build",
    "deploy": "bun run build && wrangler pages deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply open-bot-marketplace --local",
    "db:migrate": "wrangler d1 migrations apply open-bot-marketplace --remote"
  },
  "dependencies": {
    "@open-bot/plugin-kit": "workspace:*",
    "frame-master": "^4.0.2",
    "frame-master-plugin-apply-react": "^3.0.1",
    "frame-master-plugin-assets-to-build": "^0.1.1",
    "frame-master-plugin-auto-sitemap": "^0.1.0",
    "frame-master-plugin-cloudflare-pages-dynamic-ssr": "^0.3.1",
    "frame-master-plugin-cloudflare-pages-functions-action": "^4.0.1",
    "frame-master-plugin-cloudflare-route-file-generator": "^0.1.2",
    "frame-master-plugin-cloudflare-update-manager": "^0.1.2",
    "frame-master-plugin-node-polyfills": "^0.1.0",
    "frame-master-plugin-react-to-html": "^1.0.7",
    "frame-master-plugin-seo": "^0.1.1",
    "frame-master-plugin-serve-from-build": "^1.1.1",
    "frame-master-plugin-tailwind": "^2.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.137.0"
  }
}
