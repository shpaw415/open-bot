{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-bot-marketplace-review",
  "main": "src/review-consumer.ts",
  "compatibility_date": "2026-02-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-bot-marketplace",
      "database_id": "fdef926d-637c-4d77-a9e3-af9ed14393d9"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DYNAMIC_PAGE_KV",
      "id": "6bc447065f274b4da2df5bfc80fa6964"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "open-bot-marketplace-releases"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "open-bot-marketplace-security",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 2,
        "dead_letter_queue": "open-bot-marketplace-security-dlq"
      }
    ]
  }
}
